# Copy to .env and adjust. Never commit .env.
# Values left empty fall back to the development defaults in docker-compose.yml.

# --- general -----------------------------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO

# --- database ----------------------------------------------------------------------------------
POSTGRES_USER=jlr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jlr_diagnostics
POSTGRES_PORT=5433                 # host port for local tools

# --- API ---------------------------------------------------------------------------------------
# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
TELEGRAM_BOT_TOKEN=                # from @BotFather; required in production
ALLOW_DEV_AUTH=true                # MUST be false in production (the API refuses to start otherwise)
DEFAULT_ROLE=technician            # role for new users: viewer | technician (use viewer in production)
ADMIN_TELEGRAM_IDS=                # comma-separated Telegram user IDs with the admin role
API_PORT=8000

# --- diagnostic gateway ------------------------------------------------------------------------
# Shared secret between API and gateway (min 16 chars): python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKEN=
GATEWAY_INTERFACE=mock             # mock | socketcan | doip | j2534 (j2534 is not implemented yet)
GATEWAY_SIM_PROFILE=range_rover    # range_rover | range_rover_sport | defender | discovery | discovery_sport | evoque
GATEWAY_SIM_CONTROL_ENABLED=true   # simulator fault-injection endpoints (mock only)
# GATEWAY_SOCKETCAN_CHANNEL=can0
# GATEWAY_SOCKETCAN_FD=false
# GATEWAY_DOIP_HOST=169.254.0.10
# GATEWAY_DOIP_TARGETS=0x1010,0x1011
# GATEWAY_CATALOG_DIR=/catalogs     # operator-verified definition catalogs (JSON)

# --- Mini App ----------------------------------------------------------------------------------
WEB_PORT=8080
VITE_DEV_AUTH=true                 # build-time: allow sign-in outside Telegram (dev only)
